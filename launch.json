{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Trim video (no hist)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/trim_silence.py",
      "console": "integratedTerminal",
      "args": [
        "${workspaceFolder}/videos/sample.mp4",
        "--noise=${input:noiseValue}",
        "--min", "${input:minSilence}",
        "--pad", "${input:pad}",
        "--minkeep", "${input:minKeep}"
      ]
    },
    {
      "name": "Trim video (with hist)",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/trim_silence.py",
      "console": "integratedTerminal",
      "args": [
        "${workspaceFolder}/videos/sample.mp4",
        "--noise=${input:noiseValue}",
        "--min", "${input:minSilence}",
        "--pad", "${input:pad}",
        "--minkeep", "${input:minKeep}",
        "--hist",
        "--bin", "${input:binWidth}",
        "--min_db", "${input:minDb}",
        "--max_db", "${input:maxDb}"
      ]
    }
  ],
  "inputs": [
    {
      "id": "noiseValue",
      "type": "pickString",
      "description": "Silence threshold (dB, no suffix)",
      "options": ["-20","-21","-22", "-23", "-24", "-25", "-27.5"],
      "default": "-22"
    },
    {
      "id": "minSilence",
      "type": "pickString",
      "description": "Minimum silence length (sec)",
      "options": ["0.3", "0.35", "0.4", "0.5", "0.6", "0.8", "1.0"],
      "default": "0.5"
    },
    {
      "id": "pad",
      "type": "pickString",
      "description": "Padding around speech (sec)",
      "options": ["0.12","0.13", "0.14", "0.15", "0.16", "0.17", "0.20"],
      "default": "0.17"
    },
    {
      "id": "minKeep",
      "type": "pickString",
      "description": "Drop kept clips shorter than (sec)",
      "options": ["0.75", "1.0", "1.25", "1.5", "1.75", "2.0", "2.5"],
      "default": "0.75"
    },
    {
      "id": "binWidth",
      "type": "pickString",
      "description": "Histogram bin width (dB)",
      "options": ["1", "2", "3", "5", "10"],
      "default": "3"
    },
    {
      "id": "minDb",
      "type": "pickString",
      "description": "Histogram minimum dB",
      "options": ["-60", "-40", "-30", "-25"],
      "default": "-40"
    },
    {
      "id": "maxDb",
      "type": "pickString",
      "description": "Histogram maximum dB",
      "options": ["0", "-5", "-10", "-15", "-20"],
      "default": "0"
    }
  ]
}
