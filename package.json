{
  "name": "autotrim",
  "version": "0.1.0",
  "description": "An application to automatically trim silence from videos.",
  "main": "main.js",
  "author": "Znypr",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "chart.js": "^4.4.0"
  },
  "build": {
    "appId": "com.znypr.autotrim",
    "productName": "AutoTrim",
    "asar": true,
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*"
    ],
    "extraResources": [
      {
        "from": "dist/service.exe",
        "to": "python/service.exe"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "artifactName": "AutoTrim.${ext}"
    }
  }
}
